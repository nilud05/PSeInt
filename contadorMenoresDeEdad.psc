Algoritmo contadorMenoresDeEdad
	Escribir "Digite la edad de 5 aprendices"
	Leer edad1, edad2, edad3, edad4, edad5
	
	si edad1 < 18 Entonces
		counter = counter + 1
	FinSi
	
	si edad2 < 18 Entonces
		counter = counter + 1
	FinSi
	
	si edad3 < 18 Entonces
		counter = counter + 1
	FinSi
	
	si edad4 < 18 Entonces
		counter = counter + 1
	FinSi
	
	si edad5 < 18 Entonces
		counter = counter + 1
	FinSi
	
	Escribir "Hay ",  counter, " menores de edad"
FinAlgoritmo
