Algoritmo jjjjj
	Escribir "Este es el siguiente algoritmo: ax^2 + bx + c = 0. Escribe el valor de a:"
	Leer a
	Escribir "Escribe el valor de b: "
	Leer b
	Escribir "escribe el valor de c: "
	Leer c
	x = raiz(b^2 - 4 * a * c)
	resultado1 = (-b + x) / 2 * a
	resultado2 = (-b - x) / 2 * a
	Escribir "estes es el primer resultado del algoritmo: " resultado1
	Escribir "estes es el segundo resultado del algoritmo: " resultado2
FinAlgoritmo
